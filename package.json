{
  "name": "paoloscrive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.11.1",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force",
    "preview": "astro preview",
    "preview:cloudflare": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "format": "prettier --check .github/workflows/quality.yml README.md docs/deployment.md vitest.config.mjs docs/workspace.md astro.config.mjs package.json prettier.config.mjs scripts src tests tsconfig.json",
    "format:write": "prettier --write .github/workflows/quality.yml README.md docs/deployment.md vitest.config.mjs docs/workspace.md astro.config.mjs package.json prettier.config.mjs scripts src tests tsconfig.json",
    "type-check": "astro check",
    "test": "vitest run",
    "content:check": "node ./scripts/content-check.mjs",
    "content:check:public": "node ./scripts/content-check.mjs --public-only",
    "site:check": "node ./scripts/site-check.mjs",
    "workspace:init": "node ./scripts/workspace-init.mjs",
    "workspace:validate": "node ./scripts/workspace-validate.mjs",
    "nota": "node ./scripts/nota.mjs",
    "bozza": "node ./scripts/bozza.mjs",
    "pubblica": "node ./scripts/pubblica.mjs",
    "firma": "node ./scripts/firma.mjs",
    "skills:check": "node ./scripts/skill-check.mjs",
    "quality": "pnpm format && pnpm type-check && pnpm test && pnpm skills:check && pnpm content:check && pnpm build && pnpm site:check"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "astro": "^7.1.6",
    "sharp": "^0.34.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.118.0"
  }
}
