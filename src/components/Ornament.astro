---
/** The Collana's hedera: two leaves and a lozenge, used between sections. */
const leaf =
  'M20 12 C 16 6, 22 1.5, 30 3.2 C 38 5, 46 9, 54 12 C 46 15, 38 19, 30 20.8 C 22 22.5, 16 18, 20 12 Z M20 12 C 14 12, 10 8.5, 7 10 C 4.5 11.5, 5.5 15.5, 8.5 14';
---

<svg class="ornament" viewBox="0 0 120 24" aria-hidden="true">
  <path d={leaf} transform="translate(64 0)"></path>
  <path d={leaf} transform="translate(56 0) scale(-1 1)"></path>
  <rect x="58.2" y="10.2" width="3.6" height="3.6" transform="rotate(45 60 12)"></rect>
</svg>

<style>
  .ornament {
    width: 7.5rem;
    height: 1.6rem;
    margin: 1.6rem auto;
    color: var(--soft);
  }

  path,
  rect {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 0.6;
  }
</style>
