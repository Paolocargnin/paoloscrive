---
interface Props {
  label: string;
  title: string;
  id?: string;
}

const { label, title, id = 'page-title' } = Astro.props;
---

<header class="page-heading">
  <p class="kicker small-caps">{label}</p>
  <h1 id={id}>{title}</h1>
  {Astro.slots.has('default') && <div class="lede"><slot /></div>}
</header>

<style>
  .page-heading {
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .kicker {
    margin: 0;
    color: var(--soft);
    font-size: 1.05rem;
  }

  h1 {
    margin: 0.4rem 0 0;
    font-family: var(--display);
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.4rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .lede {
    max-width: 38rem;
    margin-top: 1.2rem;
    font-size: 1.3rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .lede :global(p) {
    margin: 0;
  }
</style>
