---
interface Props {
  label: string;
  title: string;
  id?: string;
}

const { label, title, id = 'page-title' } = Astro.props;
---

<header class="page-heading">
  <p class="label">{label}</p>
  <h1 id={id}>{title}</h1>
  {Astro.slots.has('default') && <div class="lede"><slot /></div>}
</header>

<style>
  .page-heading {
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  h1 {
    margin: 0.5rem 0 0;
    font-family: var(--display);
    font-size: clamp(2.8rem, 1.6rem + 5vw, 5.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .lede {
    max-width: 38rem;
    margin-top: 1.2rem;
    color: var(--faded);
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    font-style: italic;
    line-height: 1.55;
  }

  .lede :global(p) {
    margin: 0;
  }
</style>
