---
/**
 * The page of one Racconto, in its original language or in a Translation
 * (ADR 0022). Metadata always comes from the Racconto; title, description and
 * text change with the language. The text is passed in the default slot.
 *
 * Every blockquote is a story told inside the story: the one place the
 * ballpoint blue appears (direction Taccuino).
 */
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  formatDate,
  isSigned,
  postNumber,
  postUrl,
  tagLabel,
  translationLanguage,
  type Post,
  type Translation,
} from '../lib/posts';

interface Props {
  post: Post;
  allPosts: Post[];
  /** The Translations of this Racconto, to link them. */
  translations: Translation[];
  /** Set when this page shows a Translation instead of the original. */
  translation?: Translation;
}

const { post, allPosts, translations, translation } = Astro.props;
const { data } = post;
const lang = translation ? translationLanguage(translation) : data.lang;
const title = translation?.data.title ?? data.title;
const description = translation?.data.description ?? data.description;
const number = postNumber(post, allPosts);
const unsigned = translation && !isSigned(translation);

const words = {
  it: {
    readOriginal: 'Leggi l’originale in italiano',
    readIn: 'Leggilo in italiano',
    notice: 'Tradotto con l’IA dall’originale inglese. Paolo non ha ancora riletto questa traduzione.',
    signed: 'Traduzione riletta e firmata da',
  },
  en: {
    readOriginal: 'Read the English original',
    readIn: 'Read it in English',
    notice: 'Translated by AI from the Italian original. Paolo hasn’t reviewed this translation yet.',
    signed: 'Translation reviewed and signed by',
  },
} as const;
type Words = keyof typeof words;
const text = words[lang as Words];

const otherVersions = translation
  ? [{ href: postUrl(post), lang: data.lang, label: words[data.lang as Words].readOriginal }]
  : translations.map((entry) => {
      const entryLang = translationLanguage(entry);
      return { href: postUrl(post, entryLang), lang: entryLang, label: words[entryLang as Words].readIn };
    });
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  pageType="article"
  publishedAt={data.publishedAt}
  updatedAt={data.revisedAt}
>
  <SiteHeader slot="header" currentPath={Astro.url.pathname} />
  <article class="post" lang={lang === 'it' ? undefined : lang}>
    <header class="post-header">
      <p class="label" lang="it">
        <a href="/racconti/">Racconto</a> n. {number}
        · <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
        {data.revisedAt && <> · Rivisto il <time datetime={data.revisedAt.toISOString()}>{formatDate(data.revisedAt)}</time></>}
      </p>
      <h1>{title}</h1>
      <p class="deck">{description}</p>
      {
        (data.tags.length > 0 || otherVersions.length > 0) && (
          <ul class="meta-links">
            {data.tags.map((tag) => <li lang="it"><a href={`/temi/${tag}/`}>{tagLabel(tag)}</a></li>)}
            {otherVersions.map((version) => (
              <li class="language" lang={version.lang}>
                <a href={version.href} hreflang={version.lang}>{version.label}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    {unsigned && <p class="notice" role="note">{text.notice}</p>}
    <div class="prose"><slot /></div>
    <p class="end" aria-hidden="true"></p>
    {
      translation && !unsigned && translation.data.signedAt && (
        <p class="signature">
          {text.signed} {translation.data.signedBy}, {formatDate(translation.data.signedAt, lang)}.
        </p>
      )
    }
  </article>
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .post {
    padding: clamp(3rem, 8vw, 6rem) var(--gutter) clamp(3.5rem, 8vw, 6rem);
  }

  .post-header,
  .notice,
  .prose,
  .end,
  .signature {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .post-header {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .post-header .label a {
    text-decoration: none;
  }

  h1 {
    margin: 0.6rem 0 0;
    font-family: var(--display);
    font-size: clamp(2.6rem, 1.6rem + 4.5vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .deck {
    margin: 1.2rem 0 0;
    color: var(--faded);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    font-style: italic;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .meta-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
    font-variant-caps: all-small-caps;
    font-weight: 600;
    letter-spacing: 0.09em;
  }

  .meta-links .language {
    font-style: italic;
    font-variant-caps: normal;
    letter-spacing: 0;
  }

  .notice {
    margin-bottom: 2.5rem;
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 6px solid transparent;
    border-image: var(--hatch) 6;
    color: var(--faded);
    font-size: 0.95rem;
    font-style: italic;
  }

  .prose {
    font-size: clamp(1.06rem, 1rem + 0.25vw, 1.2rem);
    line-height: 1.72;
    hyphens: auto;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(figure) {
    margin-block: 0 1.1em;
  }

  .prose :global(p) {
    text-wrap: pretty;
  }

  .prose > :global(p:first-of-type::first-letter) {
    float: left;
    margin: 0.06em 0.14em 0 0;
    padding: 0 0.08em;
    background: var(--hatch-soft);
    font-family: var(--display);
    font-size: 3.7em;
    font-weight: 800;
    line-height: 0.8;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 2.4em 0 0.6em;
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .prose :global(h2) {
    font-size: 1.75em;
  }

  .prose :global(h3) {
    font-size: 1.3em;
  }

  /* A story inside the story: the only colour on the site. */
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 0.1em 0 0.1em 1.1em;
    border-left: 2px solid var(--blue);
    color: var(--blue);
    font-style: italic;
  }

  .prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  /* A scene break (---) is a short hatched bar. */
  .prose :global(hr) {
    width: 3.5rem;
    height: 8px;
    margin: 2.4em auto;
    border: 0;
    background: var(--hatch);
  }

  .prose :global(img),
  .prose :global(video) {
    height: auto;
    margin-inline: auto;
  }

  .prose :global(figcaption) {
    margin-top: 0.6em;
    color: var(--faded);
    font-size: 0.85em;
    font-style: italic;
  }

  .end {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 2.5rem;
    background: var(--hatch);
  }

  .signature {
    margin-top: 1.5rem;
    color: var(--faded);
    font-size: 0.9rem;
    font-style: italic;
  }
</style>
