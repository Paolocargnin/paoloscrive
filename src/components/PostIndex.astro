---
/**
 * The catalogue of the Collana: one line per volume, its roman numeral, its
 * title, when it was written and how long it takes to read.
 */
import { readingTime, toRoman, wordCount, writtenParts } from '../lib/collana';
import { languageName, postNumber, postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** Every published Racconto, so numbers stay the same on every list. */
  allPosts: Post[];
  label: string;
}

const { posts, allPosts, label } = Astro.props;
---

<ol class="catalogue" aria-label={label}>
  {
    posts.map((post) => {
      const number = postNumber(post, allPosts);
      const lang = post.data.lang === 'it' ? undefined : post.data.lang;
      return (
        <li>
          <span class="numeral" aria-hidden="true">{toRoman(number)}</span>
          <div class="entry">
            <a href={postUrl(post)} lang={lang}>
              <span class="visually-hidden">Volume {number}: </span>
              {post.data.title}
            </a>
            <p class="kicker small-caps">
              scritto nel {writtenParts(post.data.writtenAt, post.data.publishedAt).year}
              {' · '}si legge in {readingTime(wordCount(post.body ?? ''))}
              {lang && <> · in {languageName(post.data.lang)}</>}
            </p>
            <p class="description" lang={lang}>{post.data.description}</p>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .catalogue {
    display: grid;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
  }

  .numeral {
    font-family: var(--display);
    font-size: 2rem;
    line-height: 1;
  }

  .entry a {
    font-family: var(--display);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.8rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.15;
    text-decoration: none;
  }

  .entry a:hover {
    text-decoration: underline;
  }

  .kicker {
    margin: 0.35rem 0 0;
    color: var(--soft);
    font-size: 1.02rem;
  }

  .description {
    max-width: 40rem;
    margin: 0.3rem 0 0;
    font-size: 1.15rem;
    font-style: italic;
  }

  @media (max-width: 30rem) {
    li {
      grid-template-columns: 3rem minmax(0, 1fr);
    }

    .numeral {
      font-size: 1.5rem;
    }
  }
</style>
