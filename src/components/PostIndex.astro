---
/**
 * A list of Racconti drawn as the index of a notebook: title, a dotted leader,
 * and the Racconto's number where a page number would be.
 */
import { formatMonth, languageName, postNumber, postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** Every published Racconto, so numbers stay the same on every list. */
  allPosts: Post[];
  label: string;
}

const { posts, allPosts, label } = Astro.props;
---

<ol class="post-index" aria-label={label}>
  {
    posts.map((post) => (
      <li>
        <div class="line">
          <a href={postUrl(post)} lang={post.data.lang === 'it' ? undefined : post.data.lang}>
            {post.data.title}
          </a>
          <span class="leader" aria-hidden="true" />
          <span class="number">
            <span class="visually-hidden">Racconto n. </span>
            {postNumber(post, allPosts)}
          </span>
        </div>
        <p class="meta">
          <time datetime={post.data.publishedAt.toISOString()}>{formatMonth(post.data.publishedAt)}</time>
          {post.data.lang !== 'it' && <span> · in {languageName(post.data.lang)}</span>}
          <span> · </span>
          <span class="description" lang={post.data.lang === 'it' ? undefined : post.data.lang}>{post.data.description}</span>
        </p>
      </li>
    ))
  }
</ol>

<style>
  .post-index {
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .line a {
    min-width: 0;
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.35rem);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
  }

  .line a:hover {
    text-decoration: underline;
  }

  .leader {
    flex: 1 1 2rem;
    min-width: 2rem;
    border-bottom: 2px dotted var(--faded);
    transform: translateY(-0.3em);
  }

  .number {
    font-family: var(--display);
    font-size: 1.3rem;
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 700;
  }

  .meta {
    max-width: 44rem;
    margin: 0.2rem 0 0;
    color: var(--faded);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .description {
    font-style: italic;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
