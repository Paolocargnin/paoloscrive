---
import { siteName } from '../lib/site';
---

<footer class="site-footer">
  <span class="mark" aria-hidden="true"><i>ps</i></span>
  <p class="small-caps">{siteName} · Collana di racconti</p>
  <nav class="small-caps" aria-label="Altre pagine">
    <a href="/come-scrivo/">Come scrivo</a>
    <a href="/rss.xml">Feed RSS</a>
    <a href="#top">Torna su</a>
  </nav>
</footer>

<style>
  .site-footer {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem var(--gutter-right) 3rem var(--gutter-left);
    border-top: 1px solid var(--rule);
    color: var(--soft);
    text-align: center;
  }

  p {
    margin: 0;
    font-size: 1.05rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem 1.4rem;
    font-size: 1.05rem;
  }
</style>
