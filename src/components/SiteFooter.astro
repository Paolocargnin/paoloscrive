---
import { siteName } from '../lib/site';
---

<footer class="site-footer">
  <div class="hatch-rule" aria-hidden="true"></div>
  <div class="row">
    <p><span class="name">{siteName}</span><br />Racconti, e il percorso per arrivarci.</p>
    <nav aria-label="Altre pagine">
      <a href="/come-scrivo/">Come scrivo</a>
      <a href="/rss.xml">Feed RSS</a>
      <a href="#top">Torna su ↑</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    max-width: 72rem;
    margin-inline: auto;
    padding: 0 var(--gutter) 2.5rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.2rem;
    color: var(--faded);
    font-size: 0.92rem;
  }

  p {
    margin: 0;
  }

  .name {
    color: var(--ink);
    font-family: var(--display);
    font-style: italic;
    font-weight: 700;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-variant-caps: all-small-caps;
    font-weight: 600;
    letter-spacing: 0.09em;
  }
</style>
