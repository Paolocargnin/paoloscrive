---
import '@fontsource-variable/bodoni-moda/standard.css';
import '@fontsource-variable/bodoni-moda/standard-italic.css';
import '@fontsource-variable/literata/standard.css';
import '@fontsource-variable/literata/standard-italic.css';

import { siteName } from '../lib/site';

interface Props {
  description?: string;
  lang?: string;
  pageType?: 'article' | 'website';
  publishedAt?: Date;
  title: string;
  updatedAt?: Date;
}

const {
  description,
  lang = 'it',
  pageType = 'website',
  publishedAt,
  title,
  updatedAt,
} = Astro.props;
const site = Astro.site!;
const documentTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const configuredAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim();
const analyticsToken = import.meta.env.PROD && configuredAnalyticsToken
  ? configuredAnalyticsToken
  : undefined;
const structuredData =
  pageType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        author: {
          '@type': 'Person',
          name: 'Paolo Cargnin',
        },
        dateModified: (updatedAt ?? publishedAt)?.toISOString(),
        datePublished: publishedAt?.toISOString(),
        description,
        headline: title,
        inLanguage: lang,
        mainEntityOfPage: canonicalUrl,
        url: canonicalUrl,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        description,
        inLanguage: 'it',
        isPartOf: {
          '@type': 'WebSite',
          name: siteName,
          url: new URL('/', site).href,
        },
        name: documentTitle,
        url: canonicalUrl,
      };
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName}: feed RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={documentTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Vai al contenuto</a>
    <slot name="header" />
    <main id="main-content"><slot /></main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  /*
   * Direction A, "Taccuino" (docs/design/proposte.html): black ink on paper
   * and hatching, as in the notebook's own style guide. The only hue, a
   * ballpoint blue, is reserved for a story told inside a story.
   */
  :root {
    color-scheme: light;
    --paper: #f0ebdd;
    --paper-deep: #e6dfcb;
    --ink: #1c1b18;
    --faded: #5f5a4e;
    --rule: #cdc4ae;
    --blue: #2341a6;
    --display: 'Bodoni Moda Variable', 'Bodoni 72', Didot, 'Times New Roman', serif;
    --text: 'Literata Variable', Georgia, 'Times New Roman', serif;
    --measure: 36rem;
    --gutter: max(1rem, env(safe-area-inset-left, 0px));
    --hatch: repeating-linear-gradient(-45deg, var(--ink) 0 1px, transparent 1px 5px);
    --hatch-soft: repeating-linear-gradient(-45deg, var(--rule) 0 1px, transparent 1px 4px);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--text);
    font-optical-sizing: auto;
    font-synthesis: none;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --paper: #1a1814;
      --paper-deep: #24211b;
      --ink: #ece5d3;
      --faded: #aaa28f;
      --rule: #4a4538;
      --blue: #93a8ff;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  ::selection {
    background: var(--ink);
    color: var(--paper);
  }

  a {
    color: inherit;
    text-decoration-color: var(--faded);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-color: var(--ink);
  }

  a:focus-visible,
  button:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 0.25rem;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  .label {
    margin: 0;
    color: var(--faded);
    font-size: 0.78rem;
    font-variant-caps: all-small-caps;
    font-weight: 600;
    letter-spacing: 0.09em;
  }

  .hatch-rule {
    height: 9px;
    background: var(--hatch);
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
