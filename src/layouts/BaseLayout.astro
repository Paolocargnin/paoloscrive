---
import '@fontsource-variable/bodoni-moda/standard.css';
import '@fontsource-variable/bodoni-moda/standard-italic.css';
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';

import { siteName } from '../lib/site';

interface Props {
  description?: string;
  lang?: string;
  pageType?: 'article' | 'website';
  publishedAt?: Date;
  title: string;
  updatedAt?: Date;
}

const {
  description,
  lang = 'it',
  pageType = 'website',
  publishedAt,
  title,
  updatedAt,
} = Astro.props;
const site = Astro.site!;
const documentTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const configuredAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim();
const analyticsToken = import.meta.env.PROD && configuredAnalyticsToken
  ? configuredAnalyticsToken
  : undefined;
const structuredData =
  pageType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        author: {
          '@type': 'Person',
          name: 'Paolo Cargnin',
        },
        dateModified: (updatedAt ?? publishedAt)?.toISOString(),
        datePublished: publishedAt?.toISOString(),
        description,
        headline: title,
        inLanguage: lang,
        mainEntityOfPage: canonicalUrl,
        url: canonicalUrl,
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        description,
        inLanguage: 'it',
        isPartOf: {
          '@type': 'WebSite',
          name: siteName,
          url: new URL('/', site).href,
        },
        name: documentTitle,
        url: canonicalUrl,
      };
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName}: feed RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:title" content={documentTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={documentTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Vai al contenuto</a>
    <slot name="header" />
    <main id="main-content"><slot /></main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  /*
   * Direction B, "Collana" (ADR 0025): every Racconto is a volume of a
   * pocket series. Bodoni Moda for the wordmark, roman numerals, titles and
   * drop caps; EB Garamond for the text. Colour appears only on the spines
   * and the band of each volume.
   */
  :root {
    color-scheme: light;
    --paper: #f3f2ed;
    --ink: #1b1b18;
    --soft: #5e5c55;
    --rule: #cdc9bd;
    --plate: #ebe9e1;
    --shadow: rgba(30, 30, 20, 0.2);
    --display: 'Bodoni Moda Variable', 'Bodoni 72', Didot, 'Times New Roman', serif;
    --text: 'EB Garamond Variable', Garamond, 'Iowan Old Style', Georgia, serif;
    --measure: 33rem;
    --gutter-left: max(1rem, env(safe-area-inset-left, 0px));
    --gutter-right: max(1rem, env(safe-area-inset-right, 0px));
    background: var(--paper);
    color: var(--ink);
    font-family: var(--text);
    font-optical-sizing: auto;
    font-synthesis: none;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --paper: #131512;
      --ink: #ebe7da;
      --soft: #a9a597;
      --rule: #353830;
      --plate: #1c1f1b;
      --shadow: rgba(0, 0, 0, 0.55);
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-size: 1.15rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  ::selection {
    background: var(--ink);
    color: var(--paper);
  }

  a {
    color: inherit;
    text-decoration-color: var(--soft);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-color: var(--ink);
  }

  a:focus-visible,
  button:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 0.25rem;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  .small-caps {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .mark {
    display: grid;
    flex: none;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    font-family: var(--display);
    font-size: 1.2rem;
    font-style: italic;
  }

  .mark i {
    transform: translateY(-0.06em);
  }

  .skip-link {
    position: fixed;
    z-index: 30;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--ink);
    color: var(--paper);
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
