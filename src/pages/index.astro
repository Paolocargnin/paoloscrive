---
import { getCollection } from 'astro:content';

import Shelf from '../components/Shelf.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { siteDescription, siteName } from '../lib/site';

const posts = await getCollection('posts');
---

<PageLayout title={siteName} description={siteDescription}>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title" class="visually-hidden">{siteName}: la collana</h1>
    <p>
      Racconti numerati come i volumi di una collana tascabile, in italiano o in inglese, nella
      lingua in cui sono nati.
    </p>
  </section>
  {
    posts.length > 0 ? (
      <Shelf posts={posts} />
    ) : (
      <p class="empty">Lo scaffale è vuoto: il primo volume è ancora in preparazione.</p>
    )
  }
</PageLayout>

<style>
  .intro p {
    max-width: 34rem;
    margin: 0 0 2.6rem;
    font-size: 1.3rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
</style>
