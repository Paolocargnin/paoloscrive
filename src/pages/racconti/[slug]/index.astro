---
import { getCollection, render } from 'astro:content';

import PostArticle from '../../../components/PostArticle.astro';
import { translationsBySlug } from '../../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const translations = translationsBySlug(await getCollection('translations'));
  return allPosts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts, translations: translations.get(post.id) ?? [] },
  }));
}

const { post, allPosts, translations } = Astro.props;
const { Content } = await render(post);
---

<PostArticle post={post} allPosts={allPosts} translations={translations}>
  <Content />
</PostArticle>
