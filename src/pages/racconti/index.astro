---
import { getCollection } from 'astro:content';

import PageHeading from '../../components/PageHeading.astro';
import PostIndex from '../../components/PostIndex.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { sortPostsNewestFirst } from '../../lib/posts';

const allPosts = await getCollection('posts');
const posts = sortPostsNewestFirst(allPosts);
---

<PageLayout title="Racconti" description="Tutti i racconti di Paolo scrive, dal più recente.">
  <PageHeading label={`${posts.length} ${posts.length === 1 ? 'racconto' : 'racconti'}`} title="Racconti">
    <p>Storie inventate, brevi e meno brevi. Il numero a destra è l’ordine in cui sono arrivate.</p>
  </PageHeading>
  {
    posts.length > 0 ? (
      <PostIndex posts={posts} allPosts={allPosts} label="Racconti, dal più recente" />
    ) : (
      <p class="empty">Il primo racconto è ancora sul taccuino.</p>
    )
  }
</PageLayout>
